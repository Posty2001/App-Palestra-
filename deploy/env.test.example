# Variabili dell'ambiente TEST (da inserire nel pannello del provider, MAI in questo repository).
# DATABASE_URL è collegata automaticamente dal Blueprint.
APP_URL=https://app-palestra-test.onrender.com
SMTP_URL=                      # vuoto in TEST (recupero accesso via link del coach)
MAIL_FROM=APP PALESTRA TEST <no-reply@example.invalid>
BACKUP_AGE_RECIPIENT=age1...   # output di: age-keygen -o chiave-backup-test.txt  (riga "Public key")
BACKUP_REMOTE=r2:app-palestra-backups/test
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=          # token R2 limitato al solo bucket dei backup
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# Solo per creare gli account dimostrativi, una volta, dalla Shell del servizio (non salvare come variabile):
#   cd /app/server && NODE_ENV=test DEMO_PASSWORD='<password-lunga>' node dist/cli.js seed-demo
