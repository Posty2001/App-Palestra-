# Copia in .env e compila. Nessun valore reale va committato.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Postgres 14+ (estensione citext disponibile)
DATABASE_URL=postgres://palestra:CAMBIAMI@localhost:5432/palestra
# Database separato usato SOLO dai test automatici (viene svuotato a ogni esecuzione)
TEST_DATABASE_URL=postgres://palestra:CAMBIAMI@localhost:5432/palestra_test
# URL pubblico (link di invito e recupero). In sviluppo: il dev server Vite
APP_URL=http://localhost:5173
# Archivio privato delle foto (fuori da qualsiasi cartella servita staticamente)
STORAGE_DIR=../storage/photos
# true in produzione (HTTPS obbligatorio)
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_DAYS=60
INVITE_DAYS=7
# Facoltativo: smtp://utente:password@host:587 — senza, le email di recupero vanno solo nel log (sviluppo)
SMTP_URL=
MAIL_FROM=APP PALESTRA <no-reply@example.com>
# Solo ambiente di prova: password comune dei 3 utenti sintetici creati da `npm run seed:demo`
DEMO_PASSWORD=
# Produzione: cartella della PWA compilata servita dal server
WEB_DIST=../web/dist
